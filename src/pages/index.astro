---
import Terminal from "../components/Terminal";
import TerminalLayout from "../layouts/TerminalLayout.astro";
import MobileFallback from "../components/MobileFallback.astro";
import { loadContentData } from "../content/loadContentData";

const contentData = await loadContentData();
---

<TerminalLayout>
  <!-- Skeleton loader mientras carga el terminal -->
  <div id="terminal-skeleton" class="terminal-skeleton">
    <div class="skeleton-header">
      <div class="skeleton-dots">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="skeleton-title">terminal@pablo.dev</div>
    </div>
    <div class="skeleton-body">
      <div class="skeleton-line"></div>
      <div class="skeleton-line short"></div>
      <div class="skeleton-line"></div>
      <div class="skeleton-line medium"></div>
    </div>
  </div>

  <Terminal client:load contentData={contentData} />
  <MobileFallback />
</TerminalLayout>

<style>
  .terminal-skeleton {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 12rem),
      var(--terminal-bg);
    border-radius: 18px;
    border: 1px solid var(--terminal-border);
    box-shadow:
      0 28px 80px rgba(3, 6, 11, 0.48),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    height: 80vh;
    max-height: 800px;
    width: 100%;
    display: flex;
    flex-direction: column;
    animation: pulse 2s var(--ease-in-out) infinite;
    transition: opacity var(--motion-medium) var(--ease-in-out);
  }

  .skeleton-header {
    background-color: var(--terminal-header-bg);
    border-bottom: 1px solid var(--terminal-border);
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .skeleton-dots {
    display: flex;
    gap: 0.375rem;
  }

  .skeleton-dots span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background-color: var(--terminal-border);
  }

  .skeleton-dots span:nth-child(1) {
    background-color: color-mix(in srgb, var(--terminal-dot-close) 50%, transparent);
  }

  .skeleton-dots span:nth-child(2) {
    background-color: color-mix(in srgb, var(--terminal-dot-min) 50%, transparent);
  }

  .skeleton-dots span:nth-child(3) {
    background-color: color-mix(in srgb, var(--terminal-dot-max) 50%, transparent);
  }

  .skeleton-title {
    font-family: var(--font-mono);
    font-size: var(--font-mono-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--terminal-text-secondary);
  }

  .skeleton-body {
    flex: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .skeleton-line {
    height: 0.95rem;
    background-color: var(--terminal-border);
    border-radius: 999px;
    width: 100%;
  }

  .skeleton-line.short {
    width: 60%;
  }

  .skeleton-line.medium {
    width: 80%;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  /* Ocultar skeleton cuando el terminal carga */
  :global(body:has(.terminal) .terminal-skeleton) {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script is:inline>
  // Aplicar tema guardado antes de la hidratación para evitar FOUC
  const savedTheme = localStorage.getItem("theme") || "one-dark";
  document.documentElement.setAttribute("data-theme", savedTheme);
</script>
