<aside class="mobile-warning" role="status" aria-label="Aviso para pantallas pequeñas">
  <span class="warning-text">
    Experiencia optimizada para escritorio con teclado. La terminal sigue disponible en esta pantalla.
  </span>
  <button type="button" class="close-button" aria-label="Cerrar aviso">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
</aside>

<style>
  .mobile-warning {
    display: none;
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-modal);
    background: rgba(var(--terminal-bg-rgb), 0.96);
    color: var(--terminal-text-secondary);
    border-top: 1px solid color-mix(in srgb, var(--terminal-warning) 35%, transparent);
    padding: 0.75rem 3rem 0.75rem 1rem;
    backdrop-filter: blur(8px);
    text-align: center;
  }

  @media (max-width: 820px) {
    .mobile-warning {
      display: block;
    }
  }

  .warning-text {
    font-family: var(--font-mono);
    font-size: var(--font-mono-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .close-button {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    display: flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    border: 0;
    border-radius: var(--rounded-sm);
    background: transparent;
    color: var(--terminal-text-secondary);
    cursor: pointer;
  }

  .close-button:hover {
    color: var(--terminal-text);
  }

  .close-button:focus-visible {
    outline: 2px solid var(--terminal-accent);
    outline-offset: 2px;
  }
</style>

<script is:inline>
  const mobileWarning = document.querySelector('.mobile-warning');
  const closeButton = mobileWarning?.querySelector('.close-button');

  closeButton?.addEventListener('click', () => {
    mobileWarning?.remove();
  });
</script>
