---
// MobileWarning.astro
---

<div class="mobile-warning">
  <span class="warning-text">
    Experiencia optimizada para escritorio con teclado.
  </span>
  <button id="close-warning" class="close-button" aria-label="Cerrar aviso">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
</div>

<style>
  .mobile-warning {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(var(--terminal-bg-rgb), 0.96);
    color: var(--terminal-text-secondary);
    border-top: 1px solid rgba(216, 178, 107, 0.35);
    padding: 0.5rem 1rem;
    backdrop-filter: blur(8px);
    font-size: 0.8rem;
    text-align: center;
    animation: slideUp 0.25s ease-out;
  }

  @keyframes slideUp {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .warning-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .close-button {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    color: var(--terminal-text-secondary);
    border: none;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    opacity: 0.6;
    transition: opacity 0.15s ease;
  }

  .close-button:hover {
    opacity: 1;
  }

  @media (max-width: 680px) {
    .mobile-warning {
      display: block;
    }
  }

  [data-theme="light"] .mobile-warning {
    background: rgba(var(--terminal-bg-rgb), 0.97);
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const closeButton = document.getElementById("close-warning");
    const warning = document.querySelector(".mobile-warning");

    if (closeButton && warning) {
      closeButton.addEventListener("click", () => {
        warning.style.animation = "fadeOut 0.2s ease-out";
        setTimeout(() => {
          warning.style.display = "none";
        }, 200);
      });
    }
  });
</script>
