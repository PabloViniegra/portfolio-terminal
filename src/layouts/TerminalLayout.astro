---
import "../styles/global.css";

const pageTitle = "Portfolio de Pablo - Desarrollador Full Stack";
const pageDescription =
  "Portfolio de Pablo Viniegra, Full Stack Developer especializado en modernizar productos web, CI/CD y tooling agéntico.";
const canonicalUrl = "https://portfolio-terminal-pablo.netlify.app/";
---

<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Pablo Viniegra Picazo" />
    <meta name="theme-color" content="#11151b" />

    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/avatar.svg" />

    <link
      rel="preload"
      href="/fonts/MonaSansMonoVF.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/MonaSansVF.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="/avatar.svg" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Pablo Viniegra" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="/avatar.svg" />
  </head>
  <body
    class="min-h-screen flex items-center justify-center bg-terminal-bg text-terminal-text"
  >
    <a
      href="#terminal-output"
      class="skip-link"
    >
      Saltar al contenido
    </a>
    <main id="terminal-output" class="relative w-full max-w-5xl mx-auto p-2 md:p-6">
      <slot />
    </main>
  </body>
</html>
